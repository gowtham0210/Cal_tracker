PORT=4000
DB_PATH=./data/lighter.db
CORS_ORIGIN=http://localhost:3000
# Proxies trusted for the client IP. Behind nginx on a Docker network, use uniquelocal.
TRUST_PROXY=loopback

# Signs access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds (default 7 days).
ACCESS_TOKEN_TTL=604800

# Azure OpenAI (AI Foundry) for the coach, food estimates and meal ideas.
# Leave empty to run without AI: estimates and chat return 503, the weekly summary
# and meal ideas fall back to rule-based answers. Photo estimates need a vision model.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# `v1` uses Azure's v1 API (recommended); a dated version like 2024-10-21 also works.
AZURE_OPENAI_API_VERSION=v1
